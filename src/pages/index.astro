---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { profile, skills } from '../data/site';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title={`${profile.name} · Portofolio`} description={profile.tagline}>
  <header class="nav">
    <a class="logo" href="#top">~/{profile.name.toLowerCase()}</a>
    <nav>
      <a href="#proyek">proyek</a>
      <a href="#skill">skill</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <p class="prompt">$ whoami</p>
      <h1>{profile.name}<span class="cursor">_</span></h1>
      <p class="role">{profile.role}</p>
      <p class="lead">{profile.tagline}</p>
      <p class="meta">{profile.location} · {profile.education}</p>
      <div class="cta">
        <a class="btn primary" href="#proyek">Lihat proyek</a>
      </div>
    </section>

    <section id="proyek">
      <h2><span>01</span> proyek</h2>
      <div class="grid">
        {projects.map((p) => (
          <a class="card" href={`/proyek/${p.id}/`}>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
          </a>
        ))}
      </div>
    </section>

    <section id="skill">
      <h2><span>02</span> skill</h2>
      <div class="grid">
        {Object.entries(skills).map(([group, items]) => (
          <div class="card">
            <h3>{group}</h3>
            <ul class="tags">{items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

  </main>

  <footer>© {new Date().getFullYear()} {profile.name} · <a href={`mailto:${profile.email}`}>{profile.email}</a> · <a href={profile.github} target="_blank" rel="noopener">GitHub</a></footer>
</Base>
